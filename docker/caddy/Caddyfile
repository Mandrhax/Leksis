{
    admin 0.0.0.0:2019
    servers {
        # Reverse proxies on a private network (NPM, Traefik…) are trusted: Caddy passes their
        # X-Forwarded-* headers to the app, which detects its public address from them.
        trusted_proxies static private_ranges
    }
}

{$CADDY_HOST} {
    request_body {
        max_size 50MB
    }
    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
    }
}
