# ============================================================
# Leksis — Production Environment Variables
#
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git — it is listed in .gitignore.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# Password for the leksis_user PostgreSQL account.
# Used by docker-compose to create the user AND assembled into DATABASE_URL.
POSTGRES_PASSWORD=change_me_strong_password

# PostgreSQL major version (e.g. 18, 17, 16).
# WARNING: changing this on an existing install requires a data migration (pg_upgrade or dump/restore).
POSTGRES_VERSION=18

# Full connection string — keep the password in sync with POSTGRES_PASSWORD above.
# The hostname "postgres" resolves via the internal Docker network.
DATABASE_URL=postgresql://leksis_user:change_me_strong_password@postgres:5432/leksis

# ── NextAuth ─────────────────────────────────────────────────
# Random secret used to sign session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_openssl_rand_base64_32_output

# Public URL of the application — LEAVE EMPTY (recommended): it is detected from the
# request headers, which works for HTTP, HTTPS and behind a reverse proxy.
# Set it only to pin one fixed address (it then overrides the detected one), e.g.
#   NEXTAUTH_URL=https://leksis.yourdomain.com
NEXTAUTH_URL=

# ── Caddy Reverse Proxy ──────────────────────────────────────
# How Caddy is reached (the admin panel: Services → Caddy — or `leksis config` — changes it later):
#   CADDY_HOST=:80                    HTTP on this server's IP, or behind a reverse proxy (NPM, Traefik…)
#   CADDY_HOST=leksis.yourdomain.com  HTTPS with an automatic Let's Encrypt certificate
#                                     (the domain must point here; ports 80 and 443 must be reachable)
CADDY_HOST=:80

# ── Encryption ───────────────────────────────────────────────
# AES-256-GCM key — exactly 64 hexadecimal characters (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_char_string

# ── Ollama ───────────────────────────────────────────────────
# Local container (default): keep COMPOSE_PROFILES=ollama and the internal URL.
# Remote Ollama server:      leave COMPOSE_PROFILES empty and set AI_BASE_URL
#                            to that server, e.g. http://192.168.1.50:11434
#                            (use http://host.docker.internal:11434 for an
#                            Ollama running on this same host).
COMPOSE_PROFILES=ollama

# AI engine — "ollama" (above) or "openai" for any OpenAI-compatible API
# (vLLM, LM Studio, llama.cpp, OpenAI…). For "openai": leave COMPOSE_PROFILES empty,
# set AI_BASE_URL to the API base (e.g. http://192.168.1.50:8000/v1) and the model
# names below to the ids served by the API (GET /v1/models).
# Servers outside the private network are blocked until an admin ticks
# "Allow servers outside the private network" in Admin → Services → AI.
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_API_KEY=

# Model names (ids served by the engine) — with Ollama they must be pulled before use.
# The install.sh script handles this automatically.
AI_MODEL=translategemma:27b
AI_OCR_MODEL=maternion/LightOnOCR-2:latest
AI_REWRITE_MODEL=qwen2.5:14b

# Ollama runtime settings (only used by the local Ollama container)
# How long to keep models loaded in VRAM (-1 = forever, 5m = 5 min, 0 = unload immediately)
OLLAMA_KEEP_ALIVE=-1
# Spread model layers across multiple GPUs (install.sh always sets true)
OLLAMA_SCHED_SPREAD=true
# Maximum number of models loaded simultaneously
OLLAMA_MAX_LOADED_MODELS=3
